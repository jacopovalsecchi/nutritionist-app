generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id            String         @id @default(cuid())
  firstName     String
  lastName      String
  phone         String         @unique
  birthDate     DateTime?      @db.Date
  address       String         @default("")
  city          String         @default("")
  postalCode    String         @default("")
  reminderNote  String         @default("")
  internalNotes String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  documents     Document[]
  appointments  Appointment[]

  @@index([lastName, firstName])
}

model Document {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  storageKey   String
  label        String   @default("")
  createdAt    DateTime @default(now())

  @@index([clientId, createdAt])
}

model Setting {
  id                  String    @id @default("default")
  icloudAppleId       String    @default("")
  icloudPasswordEnc   String    @default("")
  calendarUrl         String    @default("")
  calendarDisplayName String    @default("")
  lastSyncAt          DateTime?
  lastSyncError       String    @default("")
}

model Appointment {
  id          String   @id @default(cuid())
  calendarUrl String
  icalUid     String
  title       String
  startAt     DateTime
  endAt       DateTime
  location    String   @default("")
  notes       String   @default("")
  isAllDay    Boolean  @default(false)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  matchStatus String   @default("unmatched")
  matchSource String   @default("auto")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([calendarUrl, icalUid, startAt])
  @@index([startAt])
  @@index([matchStatus, startAt])
  @@index([clientId, startAt])
}
